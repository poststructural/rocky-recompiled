/* Rocky.exe's icon, the launcher's fonts (src/ui.c) and version
 * (vk/CMakeLists.txt fills in the version). */
#include <winver.h>

1 ICON "@RKY_ROOT_NATIVE@/assets/rocky.ico"

101 RCDATA "@RKY_ROOT_NATIVE@/assets/fonts/BebasNeue-Regular.ttf"
102 RCDATA "@RKY_ROOT_NATIVE@/assets/fonts/Oswald-Regular.ttf"
103 RCDATA "@RKY_ROOT_NATIVE@/assets/fonts/Oswald-Medium.ttf"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Pacific City Recompiled"
      VALUE "FileDescription", "Rocky Recompiled"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "InternalName", "Rocky"
      VALUE "OriginalFilename", "Rocky.exe"
      VALUE "ProductName", "Rocky Recompiled"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
      VALUE "Comments", "Unofficial static recompilation. Needs your own copy of the game."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
