 BOOL xbox_translate_path(const char* xbox_path, xbox_host_char* host_path_buf, DWORD buf_size);
 
+/* Set by a host to serve some of the game's files from elsewhere (mods).
+ * Called for paths in the game's folders only, with the part below the
+ * device (e.g. "ANIMS\\FIGHTING\\FIGHTING.PAK") and the translated host
+ * path, which it may replace. Windows backend. */
+extern void (*xbox_path_override)(const char *rel, xbox_host_char *host_path, DWORD size);
+
