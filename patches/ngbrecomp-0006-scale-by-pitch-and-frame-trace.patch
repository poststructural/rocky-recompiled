+
+/* NV2A_TRACE=<seconds>: from that long after start, record 4000 frame events
+ * (a one-letter tag each, from any thread) and print them with their times:
+ * a timeline for frame-pacing problems. */
+void nv2a_trace(char tag)
+{
+    static int state = -1;   /* -1 unread, 0 off, 1 on */
+    static int64_t from_us;
+    static int64_t t[4000];
+    static char tags[4000];
+    static volatile int n;
+    int i;
+    if (state < 0) {
+        const char *e = getenv("NV2A_TRACE");
+        state = e != NULL;
+        from_us = g_get_monotonic_time() + (e ? atoi(e) : 0) * 1000000LL;
+    }
+    if (!state || g_get_monotonic_time() < from_us)
+        return;
+    i = __atomic_fetch_add(&n, 1, __ATOMIC_ACQ_REL);
+    if (i < 4000) {
+        t[i] = g_get_monotonic_time();
+        tags[i] = tag;
+    }
+    if (i == 3999) {
+        for (int j = 0; j < 4000; j++)
+            fprintf(stderr, "[TRACE] %10.3f %c\n", (t[j] - t[0]) / 1000.0, tags[j]);
+        state = 0;
+    }
+}
