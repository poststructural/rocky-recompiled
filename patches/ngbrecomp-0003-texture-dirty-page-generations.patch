+/* Every page of [addr, addr+size) is hot: left writable, so every check by a
+ * non-render-target client reports it dirty and clears nothing. The texture
+ * cache uses this to skip telling other textures on these pages that they may
+ * have changed -- their own checks will say so -- which was a walk of the
+ * whole cache per texture per draw while a title streamed into a hot page. */
+bool nv2a_dirty_range_hot(hwaddr addr, hwaddr size)
+{
+    unsigned p0, p1;
+
+    if (!s_enabled || !size)
+        return false;
+    p0 = (unsigned)(addr / PAGE);
+    p1 = (unsigned)((addr + size - 1) / PAGE);
+    if (p1 >= s_pages)
+        return false;
+    for (unsigned p = p0; p <= p1; p++)
+        if (!s_hot[p])
+            return false;
+    return true;
+}
+
 int nv2a_dirty_enabled(void)
 {
     return s_enabled;
