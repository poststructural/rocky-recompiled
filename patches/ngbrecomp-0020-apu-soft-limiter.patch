+/* Linear up to 0.75, then a smooth knee that reaches 1.0 only at infinity. */
+static float soft_limit(float x)
+{
+    float a = x < 0 ? -x : x;
+    if (a <= 0.75f)
+        return x;
+    a = 0.75f + 0.25f * tanhf((a - 0.75f) * 4.0f);
+    return x < 0 ? -a : a;
+}
